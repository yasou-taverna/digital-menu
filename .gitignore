# === יצירת מבנה הפרויקט ===
$base = "digital-menu"
New-Item -ItemType Directory -Force -Path $base
Set-Location $base

# קבצי HTML
New-Item -ItemType File -Force -Path "index.html"
New-Item -ItemType File -Force -Path "order.html"
New-Item -ItemType File -Force -Path "kitchen.html"

# תיקיית CSS
New-Item -ItemType Directory -Force -Path "css"
New-Item -ItemType File -Force -Path "css/style.css"

# תיקיית JS
New-Item -ItemType Directory -Force -Path "js"
New-Item -ItemType File -Force -Path "js/menu-data.js"
New-Item -ItemType File -Force -Path "js/tables.js"
New-Item -ItemType File -Force -Path "js/order-queue.js"
New-Item -ItemType File -Force -Path "js/api.js"

# תיקיית Apps Script
New-Item -ItemType Directory -Force -Path "apps-script"
New-Item -ItemType File -Force -Path "apps-script/Code.gs"

# README.md
"## digital-menu" | Out-File "README.md"

# === GitHub Setup ===
git init
git add .
git commit -m "first commit"
git branch -M main

git remote add origin https://github.com/yasou-taverna/digital-menu.git
git push -u origin main

Write-Host "Project created and pushed to GitHub successfully."
